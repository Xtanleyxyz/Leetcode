class Solution {
public:
    vector<vector<int>> threeSum(vector<int>& nums) {
        vector<vector<int>> solution;
        sort(nums.begin(), nums.end());

        // left to right pointer
        for (int i = 0; i < nums.size() - 2; i++) {
            int last = nums.size() - 1;
            for (int j = i + 1; j < nums.size() - 1; j++) {
                if (last == j) {
                    break;
                }
                int sum = nums[i] + nums[j] + nums[last];

                // found match
                if (sum == 0) {
                    vector<int> temp;
                    temp.push_back(nums[i]);
                    temp.push_back(nums[j]);
                    temp.push_back(nums[last]);
                    // sort(temp.begin(), temp.end());
                    auto duplicate_check = find(solution.begin(), solution.end(), temp);
                    if (duplicate_check == solution.end()) {
                        solution.push_back(temp);
                    }
                }

                // too big
                if (sum > 0) {
                    j--;
                    last--;
                }
            }
        }



        // right to left pointer
        for (int i = nums.size() - 1; i > 1; i--) {
            int first = 0;
            for (int j = i - 1; j > 0; j--) {
                if (first == j) {
                    break;
                }
                int sum = nums[i] + nums[j] + nums[first];

                // found match
                if (sum == 0) {
                    vector<int> temp;
                    temp.push_back(nums[first]);
                    temp.push_back(nums[j]);
                    temp.push_back(nums[i]);
                    // sort(temp.begin(), temp.end());
                    auto duplicate_check = find(solution.begin(), solution.end(), temp);
                    if (duplicate_check == solution.end()) {
                        solution.push_back(temp);
                    }
                }

                // too big
                if (sum < 0) {
                    j++;
                    first++;
                }
            }
        }
        return solution;
    }
};

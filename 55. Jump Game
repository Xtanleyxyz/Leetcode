class Solution {
public:
    bool canJump(vector<int>& nums) {
        bool solution = false;
        int index = 0;
        int first_pointer = nums[0];
        int second_pointer = 0;

        if (nums.size() == 1) {
            return true;
        }

        while (first_pointer != 0) {
            if ((first_pointer + index + 1) >= nums.size()) {
                return true;
            }
            first_pointer--;
            index++;
            second_pointer = nums[index];
            if (second_pointer > first_pointer){
                first_pointer = nums[index];
            }

        }

        return solution;
    }
};

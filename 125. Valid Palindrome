class Solution {
public:
    bool isPalindrome(string s) {
        string first = s;
        
        for (auto& i : first) {
            i = tolower(i);
        }
        
        for (int i = 0; i < first.size(); i++) {
            if ((first[i] < 'a' || first[i] > 'z') && (first[i] < '0' || first[i] > '9')) {
                first.erase(i,1);
                i--;
            }
        }
        
        first.erase(remove(first.begin(), first.end(), ' '), first.end());
        
        int length = first.size();
        
        cout << first << endl;
        
        for (int i = 0; i < length; i++) {
            if (first[i] != first[length - 1 - i]) {
                cout << first[i] << " " << first[length - 1 - i] << endl;
                return false;
            }
        }
        
        return true;
    }
};
